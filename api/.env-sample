# dev enables Swagger UI (/swagger/index.html) and statsviz (/kfamily-debug/statsviz/).
ENV=dev
# PORT=8080
CONNECTION_STRING=postgres://postgres:your-password@localhost:5432/kfamily?sslmode=disable

# Postgres pool (defaults shown). Keep DB_MAX_OPEN_CONNS x replicas below
# the server's max_connections.
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m

# Other browser apps (scheme://host[:port], comma-separated, no "*") allowed
# to call the API - e.g. an admin app on its own domain. The web app is
# served by this binary (and proxied by Vite in dev), so it's same-origin;
# native mobile apps and batch jobs aren't browsers and need no entry.
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# Apps besides the web app (CASDOOR_CLIENT_ID) allowed to call the API - one
# Casdoor application each. Their name is recorded on every operation they
# do. serviceUserId marks a client-credentials client (batch job): it acts
# as that service account ("user".is_service). See docs/tracing.md.
# API_CLIENTS=[{"name":"mobile","clientId":"..."},{"name":"batch:nightly-sync","clientId":"...","serviceUserId":"..."}]

# OpenTelemetry (see docs/tracing.md). Standard OTEL_* variables - traces
# are exported over OTLP/HTTP once an endpoint is set; without one, trace
# ids are still generated, returned (X-Trace-Id), logged and stored.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kfamily-api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# Where the web app (browser) exports its own spans - must be reachable from
# the browser and allow this origin (CORS); also added to the CSP.
# WEB_OTEL_TRACES_URL=http://localhost:4318/v1/traces
# WEB_OTEL_SAMPLE_RATIO=1
# Link from an operation's trace id to your tracing UI.
# TRACE_URL_TEMPLATE=http://localhost:16686/trace/{traceId}

# Casdoor application used to authenticate users.
CASDOOR_ENDPOINT=https://door.example.com
CASDOOR_CLIENT_ID=your-casdoor-application-client-id
CASDOOR_CLIENT_SECRET=your-casdoor-application-client-secret
CASDOOR_ORGANIZATION_NAME=your-casdoor-organization-name
CASDOOR_APPLICATION_NAME=your-casdoor-application-name
# PEM certificate from Casdoor's Cert management page, used to verify token
# signatures. Paste it verbatim (real line breaks) inside double quotes -
# godotenv supports multi-line quoted values, so this "just works":
CASDOOR_CERTIFICATE="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
"
